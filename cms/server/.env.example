# Copy to .env and fill in real values. Never commit .env.

PORT=4000

# Shared admin login for the marketing team.
ADMIN_USERNAME=marketing
# bcrypt hash of the shared password - generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=

# Random long string used to sign session cookies.
SESSION_SECRET=

# Fine-grained GitHub PAT, scoped to this repo only, contents:write + actions:write.
GITHUB_TOKEN=
GITHUB_OWNER=goyal21
GITHUB_REPO=aesystems-website
GITHUB_BRANCH=preprod

# Absolute path on disk where uploaded-but-not-yet-published images are staged.
UPLOAD_TMP_DIR=./data/uploads-tmp
